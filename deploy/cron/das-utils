# Путь и пользователь замените на свои.
# Файл кладётся в /etc/cron.d/das-utils
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/15 * * * * www-data cd /var/www/das-utils && /usr/bin/php artisan app:check-sites-health >> /var/www/das-utils/storage/logs/site-health.log 2>&1
0 9 * * * www-data cd /var/www/das-utils && /usr/bin/php artisan app:check-domains-whois >> /var/www/das-utils/storage/logs/whois.log 2>&1
